# JSON-RPC of the Sintrop blockchain
NEXT_PUBLIC_RPC_URL="https://rpc.sintrop.com"

# Contract set in config/contracts (addresses + ABIs generated from core-contracts).
# Regenerate with: node scripts/sync-contracts.mjs ../core-contracts mainnet sintrop-mainnet
NEXT_PUBLIC_CONTRACTS="sintrop-mainnet"

# IPFS gateway for photos, reports and inspection PDFs
NEXT_PUBLIC_IPFS_GATEWAY="https://ipfs.sintrop.com"

# Block explorer used for "check on the explorer" and transaction links
NEXT_PUBLIC_EXPLORER_URL="https://explorer.sintrop.com"

# Public URL of this portal (canonical links, Open Graph images, share links)
NEXT_PUBLIC_WEBSITE_URL="https://users.regenerationcredit.org"

# Mapbox public token (restrict it to this domain in the Mapbox dashboard)
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN="pk.xxxxxxxx"
